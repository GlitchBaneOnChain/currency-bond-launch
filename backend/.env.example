# Copy to .env and fill in. All secret material stays out of the repo.

# --- Chain ---
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# --- Postgres ---
DATABASE_URL=postgresql://bankpad:bankpad@localhost:5432/bankpad

# --- Redis (BullMQ backend) ---
REDIS_URL=redis://localhost:6379

# --- Master key for AES-256-GCM at-rest encryption ---
# Generate with: openssl rand -hex 32
BANKPAD_MASTER_KEY=

# --- Automation operator wallet ---
# EOA the backend will use to call BankpadDistributor.buyRewards /
# .distribute. Fund with the minimum gas needed. Ciphertext is stored in
# the DB; this env var is the master key for decryption.
BANKPAD_OPERATOR_ADDRESS=

# --- Server ---
PORT=8080
CORS_ORIGIN=https://bankpad.fun,https://www.bankpad.fun,https://bankpad.netlify.app,http://localhost:3000

# --- Kill switch ---
# When 1, no scheduled job runs. Individual launches can also be paused
# per-row in the DB via the `launches.paused` column.
BANKPAD_PAUSE=0

# --- Log level ---
LOG_LEVEL=info

# --- Uniswap V3 on Robinhood Chain ---
# From https://github.com/Uniswap/contracts/blob/main/deployments/4663.md
UNISWAP_V3_NFPM=0x73991a25C818Bf1f1128dEAaB1492D45638DE0D3
UNISWAP_V3_SWAP_ROUTER=0xcaf681a66D020601342297493863e78c959E5cB2
UNISWAP_V3_FACTORY=0x1f7d7550B1b028f7571E69A784071F0205FD2EfA

# --- Bankpad canonical constants ---
BANKPAD_WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
